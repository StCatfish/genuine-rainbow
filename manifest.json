{
  "manifest_version": 3,
  "name": "Genuine Rainbow",
  "version": "1.0",
  "description": "Makes the word \"genuine\" (and variations) shimmer in rainbow colors.",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}